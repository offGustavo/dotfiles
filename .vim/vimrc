function! s:SetFont(delta) abort
  " 1. If global font name isn't set, parse it from the current &guifont
  if empty(g:font_name) && !empty(&guifont)
    if &guifont =~# ':h\d\+'
      " Windows / MacVim / Neovim GUI style (e.g., JetBrainsMono_NFM:h12)
      let l:match = matchlist(&guifont, '^\(.\+\):h\(\d\+\)')
      if !empty(l:match)
        let g:font_name = l:match[1]
        let g:font_size = str2nr(l:match[2])
      endif
    elseif &guifont =~# ' \d\+$'
      " GTK / Linux style (e.g., Monospace 12)
      let l:match = matchlist(&guifont, '^\(.\+\) \(\d\+\)$')
      if !empty(l:match)
        let g:font_name = l:match[1]
        let g:font_size = str2nr(l:match[2])
      endif
    else
      let g:font_name = &guifont
    endif
  endif

  " Fallback default if name is still empty
  if empty(g:font_name)
    let g:font_name = 'JetBrainsMono NFM'
  endif

  " 2. Handle size adjustment and bounds (min: 6, max: 48)
  if a:delta == 0
    let g:font_size = 12
  else
    let g:font_size = max([6, min([48, g:font_size + a:delta])])
  endif

  " 3. Apply the font format based on your operating system/GUI
  if has('gui_gtk')
    let &guifont = g:font_name . ' ' . g:font_size
  else
    let &guifont = g:font_name . ':h' . g:font_size
  endif
endfunction

let s:fnames = []

func s:GetFiles() abort
  " fd is called 'fdfind' on Debian/Ubuntu
  let l:fd = executable('fd') ? 'fd' : executable('fdfind') ? 'fdfind' : ''
  if !empty(l:fd)
    let l:files = systemlist([l:fd, '--hidden', '--type', 'f', '--color=never', '--exclude', '.git'])
    if !v:shell_error | return l:files | endif
  endif

  if executable('rg')
    let l:files = systemlist(['rg', '--files', '--hidden', '--color=never', '--glob', '!.git'])
    if !v:shell_error | return l:files | endif
  endif

  if executable('git')
    let l:files = systemlist(['git', 'ls-files'])
    if !v:shell_error | return l:files | endif   " fails outside a git repo
  endif

  return filter(glob('**/*', v:false, v:true), '!isdirectory(v:val)')
endfunc

func FindFiles(cmdarg, cmdcomplete) abort
  if empty(s:fnames)
    let s:fnames = s:GetFiles()
  endif
  if empty(a:cmdarg)
    return copy(s:fnames)
  endif
  return matchfuzzy(s:fnames, a:cmdarg)
endfunc

let s:last_cmd = ""
function! Compile(...)
  let l:cmd = ""
  if a:0 > 0
    let l:cmd = a:1
  endif
  let l:cmd = input('$ ', s:last_cmd, 'shellcmdline')

  if empty(l:cmd)
    echoe 'Empty input, provide a command to compile. Operation canceled'
    return
  endif

  call setqflist([], ' ', {'title': l:cmd, 'lines': []})
  call setqflist([], 'a', {'lines': ["Compilation Started", " "]})
  
  copen

  call job_start(l:cmd, {
        \ 'out_cb': {_, data -> setqflist([], 'a', {'lines': [data]})},
        \ 'err_cb': {_, data -> setqflist([], 'a', {'lines': [data]})},
        \ 'exit_cb': {_, code -> setqflist([], 'a', {'lines': ['', 'finished (code ' . code . ')']})},
        \ })

  let s:last_cmd = l:cmd
endfunction

syntax on
silent color tokyo
set termguicolors nu rnu nowrap
call s:SetFont(0)
if !has('nvim')
  set guioptions=!acC
endif
set mouse=a
set laststatus=2 keymodel=startsel,stopsel
set shiftwidth=2 softtabstop=2 expandtab
set signcolumn=yes foldcolumn=2 
set foldlevel=99
if has('nvim')
  set statuscolumn=%s%l%C\ 
endif
set fillchars=foldopen:-,foldclose:+,foldsep:\ ,foldinner:\ ,fold:\ 
set viminfofile=NONE
set nobackup noswapfile foldmethod=indent
set hidden belloff=all
set wildmode=noselect:lastused,full wildoptions=pum
set complete=.,b completeopt=noinsert,menuone,popup autocomplete
set findfunc=FindFiles
if executable('rg')
  set grepprg=rg\ --vimgrep\ --hidden
endif

autocmd CmdlineChanged [:] call wildtrigger()

augroup FindFilesCache
  autocmd!                                                             
  autocmd CmdlineEnter : let s:fnames = []                             
augroup END                                                            

command! Compile   call Compile()
command! Recompile call Compile(s:last_cmd)

command! IncreaseFont call s:SetFont(1)
command! DecreaseFont call s:SetFont(-1)
command! ResetFont    call s:SetFont(0)

