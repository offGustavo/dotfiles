{
  "layer": "top",
  "position": "top",
  "height": 28,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/logo",
    "clock",
    "cpu",
    "memory",
    "temperature",
    "custom/weather",
    "hyprland/workspaces",
    "niri/workspaces",
    "hyprland/submap"
  ],
  "modules-center": [
    "custom/privacydots"
  ],
  "modules-right": [
    "tray",
    "niri/language",
    "hyprland/language",
    "backlight",
    "pulseaudio",
    "bluetooth",
    "group/networking",
    "battery",
    "custom/notification"
  ],

  // ── Left ──────────────────────────────────────────────
  "custom/logo": {
    "format": " \uf313 ",
    "tooltip": false,
    "on-click": "fuzzel -a top-left -w 20 -l 10"
  },

  "clock": {
    "format": "{:%H:%M  %a %d, %b}",
    "interval": 60,
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#d8dee9'><b>{}</b></span>",
        "weekdays": "<span color='#a3acbd'><b>{}</b></span>",
        "weeks": "<span color='#a3acbd'><b>W{:%V}</b></span>",
        "today": "<span color='#88c0d0'><b><u>{}</u></b></span>"
      }
    }
  },

  "cpu": {
    "interval": 2,
    "format": "\uf2db {usage}%",
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 5,
    "format": "\udb80\udf5b {percentage}%",
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB",
    "on-click": "kitty -e btop"
  },

  "temperature": {
    "interval": 5,
    "critical-threshold": 80,
    "format": "\uf2c9 {temperatureC}°C",
    "format-critical": "\uf2c9 {temperatureC}°C",
    "on-click": "kitty -e btop"
  },

  "custom/weather": {
    "format": "{}",
    "tooltip": true,
    "interval": 3600,
    "exec": "~/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "on-click": "xdg-open https://wttr.in/Guaratingueta"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate"
  },

  "niri/workspaces": {
    "format": "{name}"
  },

  "hyprland/submap": {
    "format": "({})",
    "tooltip": false
  },

  // ── Center ────────────────────────────────────────────
  "custom/privacydots": {
    "exec": "~/.config/waybar/scripts/privacydots.sh",
    "return-type": "json",
    "interval": 3,
    "format": "{text}",
    "tooltip": true,
    "escape": false,
    "markup": "pango"
  },

  // ── Right ─────────────────────────────────────────────
  "tray": {
    "show-passive-items": true,
    "spacing": 8
  },

  "niri/language": {
    "format": "\uf11c {short}",
    "on-click": "niri msg action switch-layout next"
  },

  "hyprland/language": {
    "format": "\uf11c {short}",
    "keyboard-name": "at-translated-set-2-keyboard",
    "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["\udb80\udcde", "\udb80\udcdf", "\udb80\udce0"],
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
    "smooth-scrolling-threshold": 1,
    "on-click": "~/.config/hypr/scripts/toggle-dark-mode.sh"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "\uf026 Muted",
    "format-icons": {
      "default": ["\uf026", "\uf027", "\uf028"]
    },
    "tooltip-format": "{desc}\n{volume}%",
    "scroll-step": 5,
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "~/.config/fuzzel/scripts/sound.sh --waybar",
    "on-click-middle": "flatpak run com.saivert.pwvucontrol"
  },

  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "",
    "format-disabled": "",
    "format-connected": "󰂯 {device_alias}",
    "format-connected-battery": "󰂯 {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "~/.config/fuzzel/scripts/bluetooth.sh --waybar",
    "on-click-middle": "adw-bluetooth"
  },

  "group/networking": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "transition-left-to-right": false
    },
    "modules": ["network", "network#speed"]
  },

  "network": {
    "interval": 5,
    "format-wifi": "\uf1eb {essid}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󱐅",
    "tooltip-format": "{ifname} | {ipaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) | {ipaddr}",
    "tooltip-format-ethernet": "{ifname} | {ipaddr}\n{bandwidthTotalBytes}",
    "tooltip-format-disconnected": "Not connected",
    "on-click": "~/.config/fuzzel/scripts/network.lua --waybar"
  },

  "network#speed": {
    "interval": 2,
    "format": "{bandwidthDownBits}",
    "format-disconnected": "",
    "tooltip-format": "{ifname} | {ipaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr} | {frequency} MHz",
    "on-click": "~/.config/fuzzel/scripts/network.lua --waybar"
  },

  "battery": {
    "interval": 30,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% {icon}",
    "format-plugged": "{capacity}% 󰂄",
    "format-full": "{capacity}% 󰁹",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂁", "󰁹"],
    "tooltip-format": "{capacity}% | {timeTo}\n{power:.1f} W",
    "on-click": "~/.config/fuzzel/scripts/power.sh --waybar"
  },

  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
